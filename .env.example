# ---------------------------------------------------------------------------
# Contact form delivery (Resend — https://resend.com)
#
# 1. Create a free Resend account and verify your sending domain.
# 2. Create an API key and paste it below.
# 3. Add these same variables in Vercel: Project Settings -> Environment Variables.
#
# Until RESEND_API_KEY and CONTACT_FROM_EMAIL are set, the contact form
# returns an honest error telling visitors to email directly, rather than
# silently swallowing their message.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Upveraoffer <hello@upveraoffer.com>"
CONTACT_TO_EMAIL=hello@upveraoffer.com

# ---------------------------------------------------------------------------
# Private admin dashboard (/admin)
#
# ADMIN_PASSWORD must contain at least 12 characters. ADMIN_SESSION_SECRET
# must be at least 32 random characters. Set both locally and in Vercel; never
# commit real credentials.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
